    "react-i18next": "^16.2.3",
    "styled-components": "^6.1.19"
  },
  "overrides": {
    "typescript": "^5.9.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
