{
  "version": "0.2.0",
  "name": "carvago-frontend-assignment",
  "description": "Assignment in React.js for developers who want to join the Carvago FE team.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Carvago/frontend-assignment"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "jest",
    "prettify": "prettier --write --config ./.prettierrc --ignore-path ./.prettierignore .",
    "eslint": "eslint --cache --fix -c ./.eslintrc.json .",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "axios": "^1.13.1",
    "cypress": "^15.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "prettier": "^3.6.2",
    "ramda": "0.32.0",
    "ramda-adjunct": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.2.3",
    "styled-components": "^6.1.19",
    "ts-pattern": "^5.9.0",
    "typescript": "^5.9.3",
    "web-vitals": "^5.1.0",
    "yup": "^1.7.1"
  },
  "overrides": {
    "typescript": "^5.9.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.0",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.1",
    "@types/ramda": "^0.30.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.7.0",
    "vite": "^6.4.1"
  }
}
